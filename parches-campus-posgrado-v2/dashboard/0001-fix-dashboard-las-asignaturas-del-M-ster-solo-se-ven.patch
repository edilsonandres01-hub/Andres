+}
+
 export interface Course {
   id: string
+  slug?: string
+  kind?: string
   title: string
   description: string
   imageUrl?: string
   published: boolean
   instructorId?: string
   modules?: any[]
+  meta?: CourseMeta
   progress: {
     completed: number
     total: number
@@ -16,6 +28,17 @@ export interface Course {
   }
 }
 
+/**
+ * Una asignatura de programa solo se cursa desde la página de su programa, que es
+ * la única vista que aplica la cascada de desbloqueo (`GET /api/programs/:slug`).
+ * La pertenencia se decide por el dato de relación `meta.programSlug`, no por el
+ * título ni por `kind`: hay cursos con `kind='program'` que no pertenecen a ningún
+ * programa (p. ej. `modulo-puente-mlops`) y deben seguir listándose como sueltos.
+ */
+export function belongsToProgram(course: Pick<Course, 'meta'>): boolean {
+  return !!course.meta?.programSlug
+}
