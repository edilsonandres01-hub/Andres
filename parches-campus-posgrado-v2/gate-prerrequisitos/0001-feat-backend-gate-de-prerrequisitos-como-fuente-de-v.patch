diff --git a/backend/lib/prerequisites.js b/backend/lib/prerequisites.js
new file mode 100644
index 0000000..fafe26b
--- /dev/null
+++ b/backend/lib/prerequisites.js
@@ -0,0 +1,157 @@
+// Gate de prerrequisitos del Máster IEP — ÚNICA fuente de verdad.
+//
+// El programa es una cascada lineal: cada asignatura declara en
+// `courses.meta->>'prerequisiteSlug'` la asignatura que hay que terminar antes.
+// La disponibilidad no está materializada en ninguna columna ni vista: se
+// deriva aquí, y SOLO aquí, a partir de `progress`.
+//
+// Semántica (compatible con el "modo consulta" de P-17, commit 7aed5bf):
+//   - LEER una asignatura bloqueada está permitido (200). El payload lo declara
+//     con `locked` + `lockedReason` para que la UI pinte el modo consulta.
+//   - AVANZAR en ella está prohibido (403 PREREQUISITE_LOCKED): registrar
+//     progreso, entregar la actividad, responder el quiz formativo, abrir o
+//     entregar un intento de examen, entregar el proyecto y los hitos del TFM.
+//
+// Instructores, dirección de TFM y admin quedan exentos: gestionan el catálogo
+// completo y necesitan ver y probar cualquier asignatura.
+const pool = require('../db/pool');
+
+const EXEMPT_ROLES = new Set(['instructor', 'admin', 'director_tfm']);
+const PREREQUISITE_LOCKED = 'PREREQUISITE_LOCKED';
+
+const isExemptRole = (user) => !!(user && EXEMPT_ROLES.has(user.role));
+
+const UNLOCKED = Object.freeze({
+  locked: false,
+  lockedReason: null,
+  prerequisiteSlug: null,
+  prerequisiteTitle: null,
+  prerequisitePercentage: null,
+});
+
+function lockedReason(title, slug) {
+  return (
+    `Para avanzar en esta asignatura primero debes completar «${title || slug}» al 100 %. ` +
+    'Puedes consultar el material, pero no registrar progreso, entregar ni examinarte.'
+  );
+}
+
+// Núcleo de la decisión. Sin E/S: recibe las cifras ya cargadas para que el
+// mismo criterio valga tanto en un listado (una consulta para N cursos) como en
+// la comprobación puntual de una escritura.
+//   prerequisiteTotal     — recursos que tiene la asignatura previa
+//   prerequisiteCompleted — recursos que el usuario tiene completados en ella
+// Una asignatura previa sin recursos no bloquea: sería una trampa sin salida.
+function evaluate({ prerequisiteSlug, prerequisiteTitle, prerequisiteTotal, prerequisiteCompleted }, user) {
+  if (!prerequisiteSlug || isExemptRole(user)) return UNLOCKED;
+  const total = Number(prerequisiteTotal || 0);
+  const done = Number(prerequisiteCompleted || 0);
+  const percentage = total > 0 ? Math.round((done / total) * 100) : 100;
+  const locked = total > 0 && done < total;
+  return {
+    locked,
+    lockedReason: locked ? lockedReason(prerequisiteTitle, prerequisiteSlug) : null,
+    prerequisiteSlug,
+    prerequisiteTitle: prerequisiteTitle || null,
+    prerequisitePercentage: percentage,
+  };
+}
+
+// Igual que `evaluate`, pero leyendo las columnas tal como las devuelve el SQL
+// de los listados (snake_case).
+function evaluateRow(row, user) {
+  return evaluate(
+    {
+      prerequisiteSlug: row.prerequisite_slug || (row.meta && row.meta.prerequisiteSlug) || null,
+      prerequisiteTitle: row.prerequisite_title,
+      prerequisiteTotal: row.prerequisite_total,
+      prerequisiteCompleted: row.prerequisite_completed,
+    },
+    user,
+  );
+}
+
+// Fragmento SQL reutilizable: cifras del prerrequisito de `c` para el usuario $N.
+const PREREQUISITE_COLUMNS = (userParam) => `
+  c.meta->>'prerequisiteSlug' AS prerequisite_slug,
+  pc.title AS prerequisite_title,
+  (SELECT count(*) FROM resources r JOIN modules m ON m.id = r.module_id
+    WHERE m.course_id = pc.id) AS prerequisite_total,
+  (SELECT count(*) FROM progress p
+     JOIN resources r ON r.id = p.resource_id
+     JOIN modules m ON m.id = r.module_id
+    WHERE m.course_id = pc.id AND p.user_id = ${userParam} AND p.completed) AS prerequisite_completed`;
+
+const PREREQUISITE_JOIN = `LEFT JOIN courses pc ON pc.slug = c.meta->>'prerequisiteSlug'`;
+
+async function stateForCourse(courseId, user) {
+  if (!courseId || !user || isExemptRole(user)) return UNLOCKED;
+  const { rows } = await pool.query(
+    `SELECT ${PREREQUISITE_COLUMNS('$2')} FROM courses c ${PREREQUISITE_JOIN} WHERE c.id = $1`,
+    [courseId, user.id],
+  );
+  return rows[0] ? evaluateRow(rows[0], user) : UNLOCKED;
+}
+
+async function stateForCourseSlug(slug, user) {
+  if (!slug || !user || isExemptRole(user)) return UNLOCKED;
+  const { rows } = await pool.query(
+    `SELECT ${PREREQUISITE_COLUMNS('$2')} FROM courses c ${PREREQUISITE_JOIN} WHERE c.slug = $1`,
+    [slug, user.id],
+  );
+  return rows[0] ? evaluateRow(rows[0], user) : UNLOCKED;
+}
+
+// Estado del curso al que pertenece un recurso (lección, examen, proyecto…).
+async function stateForResource(resourceId, user) {
+  if (!resourceId || !user || isExemptRole(user)) return UNLOCKED;
+  const { rows } = await pool.query(
+    `SELECT ${PREREQUISITE_COLUMNS('$2')}
+       FROM resources r
+       JOIN modules mo ON mo.id = r.module_id
+       JOIN courses c ON c.id = mo.course_id
+       ${PREREQUISITE_JOIN}
+      WHERE r.id = $1`,
+    [resourceId, user.id],
+  );
+  return rows[0] ? evaluateRow(rows[0], user) : UNLOCKED;
+}
+
+function forbiddenBody(state) {
+  return {
+    code: PREREQUISITE_LOCKED,
+    message: state.lockedReason,
+    prerequisiteSlug: state.prerequisiteSlug,
+    prerequisiteTitle: state.prerequisiteTitle,
+    prerequisitePercentage: state.prerequisitePercentage,
+  };
+}
+
+// Guardas para las rutas. Devuelven true si YA respondieron 403; el handler
+// solo tiene que hacer `if (await gate.denyCourse(...)) return;`.
+function makeGuard(resolve) {
+  return async (sendJSON, res, ref, user) => {
+    const state = await resolve(ref, user);
+    if (!state.locked) return false;
+    sendJSON(res, 403, forbiddenBody(state));
+    return true;
+  };
+}
+
+module.exports = {
+  PREREQUISITE_LOCKED,
+  EXEMPT_ROLES,
+  isExemptRole,
+  UNLOCKED,
+  evaluate,
+  evaluateRow,
+  PREREQUISITE_COLUMNS,
+  PREREQUISITE_JOIN,
+  stateForCourse,
+  stateForCourseSlug,
+  stateForResource,
+  forbiddenBody,
+  denyCourse: makeGuard(stateForCourse),
+  denyCourseSlug: makeGuard(stateForCourseSlug),
+  denyResource: makeGuard(stateForResource),
+};
