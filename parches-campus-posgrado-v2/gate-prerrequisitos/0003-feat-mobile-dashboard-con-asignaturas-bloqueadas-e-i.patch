+// Verificación de la caché de AsyncStorage frente al gate de prerrequisitos.
+//
+//   BASE=http://localhost:3001/api node --experimental-strip-types scripts/cache-gate-check.mjs
+//
+// La app móvil guardaba el catálogo en AsyncStorage y lo servía sin caducidad
+// ni versión: una asignatura cacheada como abierta seguía pintándose abierta
+// para siempre. Aquí se comprueba, contra la política real (src/hooks/
+// cachePolicy.ts) y contra la API real, que:
+//   - una entrada del formato antiguo, de otra versión o caducada se descarta,
+//   - una entrada sin `locked` no se considera fiable,
+//   - lo que hoy devuelve GET /courses sí declara el bloqueo.
+import {
+  CACHE_VERSION,
+  CACHE_TTL_MS,
+  inspectCacheEntry,
+  declaresLockState,
+  makeEnvelope,
+} from '../src/hooks/cachePolicy.ts';
+
+const BASE = process.env.BASE || 'http://localhost:3001/api';
+let pass = 0;
+let fail = 0;
+const ok = (cond, msg, extra) => {
+  if (cond) {
+    pass += 1;
+    console.log('  ✓', msg);
+  } else {
+    fail += 1;
+    console.log('  ✗', msg, extra !== undefined ? `\n      → ${JSON.stringify(extra)}` : '');
+  }
+};
+
+const NOW = 1_800_000_000_000;
+
+console.log('\n1. Entradas de caché que deben descartarse');
+// Lo que escribía la versión anterior: el array pelado, sin envoltorio.
+const legado = JSON.stringify([
+  { id: 'a', slug: 'master-ii', title: 'II', locked: false },
+]);
+let v = inspectCacheEntry(legado, NOW);
+ok(!v.usable && v.discard, `formato antiguo sin versión → se borra (${v.reason})`, v);
+
+v = inspectCacheEntry(JSON.stringify({ v: 1, at: NOW, data: [] }), NOW);
+ok(!v.usable && v.discard, `versión anterior → se borra (${v.reason})`, v);
+
+v = inspectCacheEntry(JSON.stringify(makeEnvelope([], NOW - CACHE_TTL_MS - 1)), NOW);
+ok(!v.usable && !v.discard, `caducada → no se sirve, pero se conserva para modo offline (${v.reason})`, v);
+
+v = inspectCacheEntry('{no es json', NOW);
+ok(!v.usable && v.discard, `JSON corrupto → se borra (${v.reason})`, v);
+
+v = inspectCacheEntry(null, NOW);
+ok(!v.usable, 'sin entrada → nada que servir');
+
+console.log('\n2. Entradas que sí valen');
+v = inspectCacheEntry(JSON.stringify(makeEnvelope([{ id: 'a' }], NOW - 1000)), NOW);
+ok(v.usable && !v.stale, `entrada v${CACHE_VERSION} fresca → se sirve`);
+v = inspectCacheEntry(JSON.stringify(makeEnvelope([{ id: 'a' }], NOW - CACHE_TTL_MS - 1)), NOW, true);
+ok(v.usable && v.stale, 'entrada caducada en modo offline → se sirve marcada como rancia');
+
+console.log('\n3. Caché sucia: bloqueada en el servidor, guardada como abierta');
+const sucia = [
+  { id: '1', slug: 'master-i', title: 'I', locked: false },
+  { id: '2', slug: 'master-ii', title: 'II', prerequisiteSlug: 'master-i' }, // sin `locked`
+];
+ok(!declaresLockState(sucia), 'un catálogo sin `locked` en una asignatura con prerrequisito NO es fiable');
+const limpia = [
+  { id: '1', slug: 'master-i', title: 'I', locked: false },
+  { id: '2', slug: 'master-ii', title: 'II', prerequisiteSlug: 'master-i', locked: true },
+];
+ok(declaresLockState(limpia), 'un catálogo que declara `locked` sí es fiable');
+
+console.log('\n4. Lo que el móvil recibe hoy de la API');
+const email = `movil${Date.now()}@example.com`;
+const reg = await (
+  await fetch(`${BASE}/auth/register`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ email, name: 'Móvil', password: 'Password123' }),
+  })
+).json();
+const H = { authorization: `Bearer ${reg.accessToken}`, 'content-type': 'application/json' };
+const courses = await (await fetch(`${BASE}/courses`, { headers: H })).json();
+const master = courses.filter((c) => (c.meta || {}).programSlug === 'master-iep');
+ok(master.length > 0, `GET /courses devuelve ${master.length} asignaturas del Máster`);
+ok(declaresLockState(courses), 'el payload real pasa el control de fiabilidad de la caché');
+const ii = master.find((c) => c.slug === 'master-ii');
+ok(ii && ii.locked === true, 'master-ii llega al móvil marcada como bloqueada', ii && { locked: ii.locked });
+ok(!!(ii && ii.lockedReason), 'llega con el motivo para pintarlo en la tarjeta');
+
+console.log('\n5. Aunque la caché mintiera, el servidor no cede');
+const res2 = await (await fetch(`${BASE}/courses/master-ii`, { headers: H })).json();
+const manual = res2.modules
+  .flatMap((m) => m.resources)
+  .find((r) => ['book', 'video', 'docs', 'reading', 'lecture', 'tool'].includes(r.type));
+const w = await fetch(`${BASE}/progress`, {
+  method: 'POST',
+  headers: H,
+  body: JSON.stringify({ resourceId: manual.id }),
+});
+const wb = await w.json();
+ok(w.status === 403 && wb.code === 'PREREQUISITE_LOCKED', 'una escritura desde el móvil con caché sucia → 403', {
+  status: w.status,
+  code: wb.code,
+});
+
+console.log(`\n${pass} ok, ${fail} fallo(s)`);
+process.exit(fail ? 1 : 0);
