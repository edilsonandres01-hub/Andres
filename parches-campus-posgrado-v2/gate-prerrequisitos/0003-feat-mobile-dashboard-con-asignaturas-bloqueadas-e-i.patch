+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { inspectCacheEntry, makeEnvelope } from './cachePolicy';
+
+// Caché local del catálogo. Vive aquí, y no dentro de useCourses, para que el
+// interceptor de errores de la API pueda invalidarla sin importar el hook (y
+// sin crear un ciclo de imports). La política —qué entrada vale y cuál se
+// tira— está en cachePolicy.ts, que no depende de React Native y se prueba
+// aparte.
+
+export const COURSES_CACHE_KEY = 'courses_cache';
+export const PROGRESS_CACHE_KEY = 'progress_cache';
+
+export { CACHE_VERSION, CACHE_TTL_MS } from './cachePolicy';
+
+export async function writeCache<T>(key: string, data: T) {
+  await AsyncStorage.setItem(key, JSON.stringify(makeEnvelope(data, Date.now())));
+}
+
+export async function readCache<T>(key: string, { allowStale = false } = {}): Promise<T | null> {
+  const verdict = inspectCacheEntry(await AsyncStorage.getItem(key), Date.now(), allowStale);
+  if (verdict.usable) return verdict.data as T;
+  if (verdict.discard) await AsyncStorage.removeItem(key);
+  return null;
+}
+
+/**
+ * Borra el estado cacheado del catálogo y el progreso. Se llama al cerrar
+ * sesión y en cuanto el servidor responde 403 PREREQUISITE_LOCKED: ese 403
+ * significa que lo que el móvil creía abierto está en realidad bloqueado.
+ */
+export async function invalidateCourseCache() {
+  await AsyncStorage.multiRemove([COURSES_CACHE_KEY, PROGRESS_CACHE_KEY]);
+}
