+// Política de la caché local del catálogo. Sin dependencias: es la parte que
+// decide si una entrada guardada en AsyncStorage sirve o hay que tirarla, y se
+// puede ejercitar de forma aislada (mobile/scripts/cache-gate-check.mjs).
+
+// Subir esta versión invalida TODA la caché guardada en el dispositivo. Se
+// subió a 2 al introducir `locked`: una caché v1 se grabó cuando el backend no
+// enviaba el campo, y servirla dejaría asignaturas bloqueadas pintadas como
+// abiertas.
+export const CACHE_VERSION = 2;
+
+// Vencida la ventana, la entrada deja de valer como respuesta y pasa a ser solo
+// red de seguridad para cuando no hay conexión.
+export const CACHE_TTL_MS = 5 * 60 * 1000;
+
+export interface CacheEnvelope<T> {
+  v: number;
+  at: number;
+  data: T;
+}
+
+export type CacheVerdict =
+  | { usable: true; stale: boolean; data: any }
+  | { usable: false; discard: boolean; reason: string };
+
+/**
+ * Decide qué hacer con lo que hay guardado bajo una clave.
+ *   usable  — se puede servir
+ *   stale   — está caducada (solo aceptable en modo offline)
+ *   discard — hay que borrarla del dispositivo, no volverá a ser válida
+ */
+export function inspectCacheEntry(raw: string | null, now: number, allowStale = false): CacheVerdict {
+  if (raw === null || raw === undefined) return { usable: false, discard: false, reason: 'vacía' };
+  let parsed: any;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    return { usable: false, discard: true, reason: 'JSON corrupto' };
+  }
+  // Formato antiguo: el payload se guardaba pelado, sin envoltorio ni versión.
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    return { usable: false, discard: true, reason: 'formato antiguo sin versión' };
+  }
+  if (parsed.v !== CACHE_VERSION) {
+    return { usable: false, discard: true, reason: `versión ${parsed.v} ≠ ${CACHE_VERSION}` };
+  }
+  const stale = now - Number(parsed.at || 0) > CACHE_TTL_MS;
+  if (stale && !allowStale) return { usable: false, discard: false, reason: 'caducada' };
+  return { usable: true, stale, data: parsed.data };
+}
+
+/**
+ * Una caché de cursos en la que alguna asignatura con prerrequisito no declara
+ * `locked` viene de un backend anterior al gate: no se puede confiar en ella
+ * para decidir qué está abierto, aunque la versión y la frescura cuadren.
+ */
+export function declaresLockState(courses: any): boolean {
+  return (
+    Array.isArray(courses) &&
+    courses.every((c: any) => c && (c.locked !== undefined || !c.prerequisiteSlug))
+  );
+}
+
+export function makeEnvelope<T>(data: T, now: number): CacheEnvelope<T> {
+  return { v: CACHE_VERSION, at: now, data };
+}
