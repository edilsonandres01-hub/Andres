@@ -1,6 +1,7 @@
 # ─── Campus Posgrado v2 · backend (simple-server.js + PostgreSQL) ───
 # Copia a `.env` para desarrollo local. En Railway se configuran como variables
-# del servicio. Solo `ANTHROPIC_API_KEY` es secreto; el resto es configuración.
+# del servicio. Solo `LLM_API_KEY` (y su alias histórico `ANTHROPIC_API_KEY`) es
+# secreto; el resto es configuración.
 
 # ── Base de datos (obligatorio) ──────────────────────────────────────
 # Opción A: cadena única (la que usa Railway)
@@ -32,13 +33,54 @@ SEED_DEMO_DATA=false
 #EXAM_COOLDOWN_HOURS=24
 
 # ── Integración LLM (tutor socrático + asistencia de nota) ────────────
-# LLM_PROVIDER: none (por defecto, sin IA) | anthropic
+# LLM_PROVIDER:
+#   none              → por defecto, sin IA (el tutor usa su FAQ de respaldo y
+#                       /grade-suggestion responde 501)
+#   nvidia            → NVIDIA NIM, API OpenAI-compatible (configuración actual)
+#   openai-compatible → cualquier otro /chat/completions; exige LLM_BASE_URL
+#   anthropic         → API nativa de Anthropic (camino histórico, sigue operativo)
 LLM_PROVIDER=none
-LLM_MODEL=claude-sonnet-5
-LLM_MODEL_HEAVY=claude-opus-5
-# SECRETO — solo si LLM_PROVIDER=anthropic. No lo pongas en este fichero de ejemplo.
+
+# Modelos. Los valores por defecto dependen del proveedor:
+#   nvidia/openai-compatible → moonshotai/kimi-k3 en ambos
+#   anthropic                → claude-sonnet-5 / claude-opus-5
+LLM_MODEL=moonshotai/kimi-k3
+LLM_MODEL_HEAVY=moonshotai/kimi-k3
+
+# SECRETO — clave del proveedor activo. No pongas nunca el valor real aquí.
+# Es genérica a propósito: cambiar de proveedor no obliga a renombrar la variable.
+#LLM_API_KEY=
+# Alias histórico, solo se lee con LLM_PROVIDER=anthropic.
 #ANTHROPIC_API_KEY=
 
+# Raíz de la API OpenAI-compatible, sin /chat/completions.
+# Con LLM_PROVIDER=nvidia se asume este valor y no hace falta declararla.
+#LLM_BASE_URL=https://integrate.api.nvidia.com/v1
+
+# ── Presupuesto de tokens ─────────────────────────────────────────────
+# kimi-k3 es un modelo de RAZONAMIENTO: gasta parte de max_tokens en su cadena
+# de pensamiento (message.reasoning_content) antes de escribir la respuesta.
+# Con los límites pensados para Claude la salida se trunca y el JSON de
+# /grade-suggestion y del banco de ítems llega incompleto. Defaults:
+#   proveedor de razonamiento → 3000 / 6000 / 16000
+#   anthropic                 →  700 / 1200 /  4000
+#LLM_MAX_TOKENS_TUTOR=3000
+#LLM_MAX_TOKENS_GRADE=6000
+#LLM_MAX_TOKENS_ITEMS=16000
+
+# `reasoning_effort` solo se envía si esta variable tiene valor. El enum admitido
+# depende del endpoint; con NVIDIA + kimi-k3 está comprobado que acepta 'max'.
+# Déjala vacía salvo que sepas que tu endpoint admite el valor que le pones.
+#LLM_REASONING_EFFORT=
+
+# ── Robustez de red del LLM ───────────────────────────────────────────
+# Timeout por petición en ms (def. 180000: un modelo de razonamiento con 16k
+# tokens de presupuesto tarda minutos).
+#LLM_TIMEOUT_MS=180000
+# Reintentos con espera creciente ante 429/5xx (def. 2). El plan gratuito de
+# NVIDIA devuelve 429 con mucha facilidad.
+#LLM_MAX_RETRIES=2
+
 # ── Referencia de catálogo por asignatura (opcional) ─────────────────
 # El IEP no publica clave de catálogo por asignatura; el seed usa
 # `IEP-<numeral>-INTERNO`. Si el IEP facilita la clave real, se inyecta aquí
