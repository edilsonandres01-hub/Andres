+//                     (def. https://integrate.api.nvidia.com/v1 con 'nvidia')
+//
+// Cuando PROVIDER='none' todo devuelve null/[] y quien llama usa su fallback
 // (FAQ redactada, o 501 en la ruta de asistencia de nota).
 
 const PROVIDER = process.env.LLM_PROVIDER || 'none';
-const MODEL = process.env.LLM_MODEL || 'claude-sonnet-5';
-const MODEL_HEAVY = process.env.LLM_MODEL_HEAVY || 'claude-opus-5';
-const KEY = process.env.ANTHROPIC_API_KEY || '';
+
+const OPENAI_COMPATIBLE = PROVIDER === 'nvidia' || PROVIDER === 'openai-compatible';
+const NVIDIA_BASE_URL = 'https://integrate.api.nvidia.com/v1';
+
+const DEFAULT_MODELS = OPENAI_COMPATIBLE
+  ? { light: 'moonshotai/kimi-k3', heavy: 'moonshotai/kimi-k3' }
+  : { light: 'claude-sonnet-5', heavy: 'claude-opus-5' };
+
+const MODEL = process.env.LLM_MODEL || DEFAULT_MODELS.light;
+const MODEL_HEAVY = process.env.LLM_MODEL_HEAVY || DEFAULT_MODELS.heavy;
+
+// La clave genérica sirve para todos los proveedores. ANTHROPIC_API_KEY se
+// mantiene como alias exclusivo del camino Anthropic para no romper despliegues.
+const KEY = process.env.LLM_API_KEY || (PROVIDER === 'anthropic' ? process.env.ANTHROPIC_API_KEY || '' : '');
+
+const BASE_URL = (process.env.LLM_BASE_URL || (PROVIDER === 'nvidia' ? NVIDIA_BASE_URL : '')).replace(/\/+$/, '');
+
 const ANTHROPIC_URL = 'https://api.anthropic.com/v1/messages';
 
 function enabled() {
-  return PROVIDER === 'anthropic' && !!KEY;
+  if (!KEY) return false;
+  if (PROVIDER === 'anthropic') return true;
+  if (OPENAI_COMPATIBLE) return !!BASE_URL;
+  return false;
 }
 
-async function callAnthropic({ system, messages, maxTokens = 1024, model = MODEL }) {
-  if (!enabled()) throw new Error('LLM_DISABLED');
-  const r = await fetch(ANTHROPIC_URL, {
+async function postJSON(url, headers, payload) {
+  const r = await fetch(url, {
     method: 'POST',
-    headers: {
