 }
 
-module.exports = { enabled, tutor, gradeSuggestion, draftItems, MODEL, MODEL_HEAVY, PROVIDER };
+module.exports = { enabled, tutor, gradeSuggestion, draftItems, MODEL, MODEL_HEAVY, PROVIDER, BUDGET };
