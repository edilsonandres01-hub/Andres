From: Cursor Agent <cursor@cursor.com>
Date: Wed, 9 Sep 2026 01:43:38 +0000
Subject: [PATCH 2/3] =?UTF-8?q?fix(llm):=20presupuesto=20de=20tokens=20de?=
 =?UTF-8?q?=20razonamiento=20y=20truncaci=C3=B3n=20que=20no=20falla=20en?=
 =?UTF-8?q?=20silencio?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

kimi-k3 es un modelo de razonamiento: gasta parte de `max_tokens` en su
cadena de pensamiento ANTES de escribir la respuesta. Medido contra la API
real, con max_tokens=20 y el prompt 'responde solo: OK' la respuesta acaba
con finish_reason='length', completion_tokens=20 y content vacío: los 20
tokens se fueron íntegros en reasoning_content. Con los límites pensados
para Claude (700/1200/4000) las tres funciones se truncan, y las dos que
esperan JSON devolvían null/[] sin distinguirlo de 'el modelo no dijo nada'.

- Presupuestos configurables por función y por defecto según el proveedor:
  razonamiento 3000/6000/16000, anthropic los 700/1200/4000 de siempre.
  Variables: LLM_MAX_TOKENS_TUTOR, _GRADE, _ITEMS.
- El transporte devuelve ahora { text, truncated, usage }. `truncated` sale
  de finish_reason==='length' (o stop_reason==='max_tokens' en Anthropic).
- gradeSuggestion y draftItems lanzan LLM_TRUNCATED con el presupuesto y el
  consumo, y LLM_BAD_JSON si la salida no es parseable. La ruta de
  /grade-suggestion ya convertía las excepciones en 502, así que el fallo
  pasa a ser visible en vez de mudo. El tutor devuelve la respuesta parcial
  —sigue siendo más útil que el fallback genérico— pero deja el aviso en el
  log.
- LLM_REASONING_EFFORT: se envía como `reasoning_effort` solo si tiene
  valor. Vacía por defecto porque el enum aceptado depende del endpoint;
  con NVIDIA + kimi-k3 está comprobado que acepta 'max'.

Se añaden además dos protecciones que este endpoint hace necesarias:
LLM_TIMEOUT_MS (def. 180000; con 16k tokens de presupuesto un modelo de
razonamiento tarda minutos y fetch no trae timeout) y LLM_MAX_RETRIES
(def. 2, espera exponencial con techo de 20s) ante 429 y 5xx, porque el
plan gratuito de NVIDIA responde 429 con mucha facilidad.
---
 backend/lib/llm.js | 172 ++++++++++++++++++++++++++++++++++-----------
 1 file changed, 131 insertions(+), 41 deletions(-)

diff --git a/backend/lib/llm.js b/backend/lib/llm.js
index db72236..741bdbb 100644
--- a/backend/lib/llm.js
+++ b/backend/lib/llm.js
@@ -20,6 +20,27 @@
 // ── Endpoint (solo proveedores OpenAI-compatibles) ───────────────────
 //   LLM_BASE_URL      raíz de la API, sin /chat/completions
 //                     (def. https://integrate.api.nvidia.com/v1 con 'nvidia')
+//   LLM_REASONING_EFFORT  se envía como `reasoning_effort` si está definida;
+//                     vacía = no se manda el parámetro. El enum admitido depende
+//                     del endpoint, así que déjala vacía salvo que sepas que el
+//                     tuyo acepta el valor.
+//
+// ── Presupuesto de tokens ────────────────────────────────────────────
+// kimi-k3 y demás modelos de razonamiento gastan parte de `max_tokens` en la
+// cadena de pensamiento (`choices[0].message.reasoning_content`) ANTES de
+// escribir la respuesta. Con los límites pensados para Claude (700/1200/4000)
+// la salida se trunca y, en las dos funciones que devuelven JSON, el JSON queda
+// a medias. Por eso los presupuestos por defecto son mucho más altos cuando el
+// proveedor es de razonamiento, y son configurables:
+//   LLM_MAX_TOKENS_TUTOR  (def. 3000 razonamiento /  700 anthropic)
+//   LLM_MAX_TOKENS_GRADE  (def. 6000 razonamiento / 1200 anthropic)
+//   LLM_MAX_TOKENS_ITEMS  (def. 16000 razonamiento / 4000 anthropic)
+//
+// ── Robustez de red ──────────────────────────────────────────────────
+//   LLM_TIMEOUT_MS    corta la petición (def. 180000; un modelo de razonamiento
+//                     con 16k tokens de presupuesto tarda minutos)
+//   LLM_MAX_RETRIES   reintentos con espera creciente ante 429/5xx (def. 2).
+//                     El plan gratuito de NVIDIA responde 429 con facilidad.
 //
 // Cuando PROVIDER='none' todo devuelve null/[] y quien llama usa su fallback
 // (FAQ redactada, o 501 en la ruta de asistencia de nota).
@@ -41,9 +62,26 @@ const MODEL_HEAVY = process.env.LLM_MODEL_HEAVY || DEFAULT_MODELS.heavy;
 const KEY = process.env.LLM_API_KEY || (PROVIDER === 'anthropic' ? process.env.ANTHROPIC_API_KEY || '' : '');
 
 const BASE_URL = (process.env.LLM_BASE_URL || (PROVIDER === 'nvidia' ? NVIDIA_BASE_URL : '')).replace(/\/+$/, '');
+const REASONING_EFFORT = process.env.LLM_REASONING_EFFORT || '';
 
 const ANTHROPIC_URL = 'https://api.anthropic.com/v1/messages';
 
+const TIMEOUT_MS = num(process.env.LLM_TIMEOUT_MS, 180000);
+const MAX_RETRIES = num(process.env.LLM_MAX_RETRIES, 2);
+
+// Presupuestos por función. Los de razonamiento incluyen el coste del
+// pensamiento intermedio, que no se devuelve al usuario pero sí se factura.
+const BUDGET = {
+  tutor: num(process.env.LLM_MAX_TOKENS_TUTOR, OPENAI_COMPATIBLE ? 3000 : 700),
+  grade: num(process.env.LLM_MAX_TOKENS_GRADE, OPENAI_COMPATIBLE ? 6000 : 1200),
+  items: num(process.env.LLM_MAX_TOKENS_ITEMS, OPENAI_COMPATIBLE ? 16000 : 4000),
+};
+
+function num(v, def) {
+  const n = Number.parseInt(v, 10);
+  return Number.isFinite(n) && n > 0 ? n : def;
+}
+
 function enabled() {
   if (!KEY) return false;
   if (PROVIDER === 'anthropic') return true;
@@ -51,17 +89,43 @@ function enabled() {
   return false;
 }
 
+function sleep(ms) {
+  return new Promise((r) => setTimeout(r, ms));
+}
+
+// Espera exponencial con techo: 1s, 2s, 4s… hasta 20s. El techo evita que subir
+// LLM_MAX_RETRIES convierta la espera en horas.
+function backoffMs(attempt) {
+  return Math.min(1000 * Math.pow(2, attempt), 20000);
+}
+
+// POST con reintento acotado ante 429 y 5xx. Los 4xx que no son 429 no se
+// reintentan: son errores de configuración (clave mala, modelo inexistente).
 async function postJSON(url, headers, payload) {
-  const r = await fetch(url, {
-    method: 'POST',
-    headers: { 'content-type': 'application/json', ...headers },
-    body: JSON.stringify(payload),
-  });
-  if (!r.ok) {
+  let last;
+  for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
+    let r;
+    try {
+      r = await fetch(url, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', ...headers },
+        body: JSON.stringify(payload),
+        signal: AbortSignal.timeout(TIMEOUT_MS),
+      });
+    } catch (e) {
+      last = new Error(`${PROVIDER} network: ${e.message}`);
+      if (attempt === MAX_RETRIES) throw last;
+      await sleep(backoffMs(attempt));
+      continue;
+    }
+    if (r.ok) return r.json();
     const detail = await r.text().catch(() => '');
-    throw new Error(`${PROVIDER} ${r.status}: ${detail.slice(0, 300)}`);
+    last = new Error(`${PROVIDER} ${r.status}: ${detail.slice(0, 300)}`);
+    if (r.status !== 429 && r.status < 500) throw last;
+    if (attempt === MAX_RETRIES) throw last;
+    await sleep(backoffMs(attempt));
   }
-  return r.json();
+  throw last;
 }
 
 // --- Transporte: Anthropic /v1/messages ---
@@ -71,11 +135,12 @@ async function callAnthropic({ system, messages, maxTokens, model }) {
     { 'x-api-key': KEY, 'anthropic-version': '2023-06-01' },
     { model, max_tokens: maxTokens, system, messages },
   );
-  return (j.content || [])
+  const text = (j.content || [])
     .filter((b) => b.type === 'text')
     .map((b) => b.text)
     .join('')
     .trim();
+  return { text, truncated: j.stop_reason === 'max_tokens', usage: j.usage || null };
 }
 
 // --- Transporte: OpenAI-compatible /chat/completions (NVIDIA NIM) ---
@@ -86,31 +151,41 @@ async function callAnthropic({ system, messages, maxTokens, model }) {
 //    llegar al usuario ni a los `JSON.parse` de gradeSuggestion/draftItems.
 //  · Sin streaming: quien llama es síncrono y no lo necesita.
 async function callOpenAICompatible({ system, messages, maxTokens, model }) {
-  const j = await postJSON(
-    `${BASE_URL}/chat/completions`,
-    { authorization: `Bearer ${KEY}` },
-    {
-      model,
-      max_tokens: maxTokens,
-      messages: system ? [{ role: 'system', content: system }, ...messages] : messages,
-      stream: false,
-    },
-  );
-  const raw = (j.choices || [])[0]?.message?.content;
+  const payload = {
+    model,
+    max_tokens: maxTokens,
+    messages: system ? [{ role: 'system', content: system }, ...messages] : messages,
+    stream: false,
+  };
+  if (REASONING_EFFORT) payload.reasoning_effort = REASONING_EFFORT;
+
+  const j = await postJSON(`${BASE_URL}/chat/completions`, { authorization: `Bearer ${KEY}` }, payload);
+  const choice = (j.choices || [])[0] || {};
+  const raw = choice.message?.content;
   // Algunos endpoints devuelven content como array de bloques tipo OpenAI vision.
-  return (Array.isArray(raw) ? raw.map((p) => p?.text || '').join('') : String(raw || ''))
+  const text = (Array.isArray(raw) ? raw.map((p) => p?.text || '').join('') : String(raw || ''))
     // Red de seguridad: si un modelo mete el pensamiento en línea en vez de en
     // reasoning_content, se elimina igualmente.
     .replace(/<think>[\s\S]*?<\/think>/gi, '')
     .trim();
+  return { text, truncated: choice.finish_reason === 'length', usage: j.usage || null };
 }
 
+// Devuelve { text, truncated, usage }. `truncated` es la señal de que el
+// presupuesto de tokens se agotó antes de que el modelo terminara de escribir.
 async function complete({ system, messages, maxTokens = 1024, model = MODEL }) {
   if (!enabled()) throw new Error('LLM_DISABLED');
   const args = { system, messages, maxTokens, model };
   return OPENAI_COMPATIBLE ? callOpenAICompatible(args) : callAnthropic(args);
 }
 
+function usageLine(usage) {
+  if (!usage) return '';
+  const c = usage.completion_tokens ?? usage.output_tokens;
+  const p = usage.prompt_tokens ?? usage.input_tokens;
+  return ` (prompt ${p}, completion ${c})`;
+}
+
 // --- Tutor socrático anclado en la lección (Fase 4) ---
 function tutorSystemPrompt(lessonContext, resources) {
   return [
@@ -134,12 +209,37 @@ function tutorSystemPrompt(lessonContext, resources) {
 
 async function tutor({ lessonContext, resources, history = [], question }) {
   if (!enabled()) return { text: null, disabled: true };
-  const text = await complete({
+  const { text, truncated, usage } = await complete({
     system: tutorSystemPrompt(lessonContext, resources),
     messages: [...history, { role: 'user', content: String(question || '') }],
-    maxTokens: 700,
+    maxTokens: BUDGET.tutor,
   });
-  return { text, disabled: false };
+  if (truncated) {
+    // Aquí una respuesta a medias sigue siendo más útil que el fallback genérico,
+    // pero el aviso tiene que quedar en el log: significa que LLM_MAX_TOKENS_TUTOR
+    // se queda corto para el razonamiento del modelo.
+    console.warn(`[llm] tutor truncado por max_tokens=${BUDGET.tutor}${usageLine(usage)}`);
+  }
+  return { text: text || null, disabled: false, truncated };
+}
+
+// Extrae el primer bloque JSON del texto. Falla ruidosamente: una salida
+// truncada o no parseable es un error recuperable (la ruta responde 502), no un
+// `null` silencioso indistinguible de "el modelo no tenía nada que decir".
+function parseJSONBlock({ text, truncated, usage }, { open, close, label, budget }) {
+  if (truncated) {
+    throw new Error(
+      `LLM_TRUNCATED: ${label} agotó max_tokens=${budget}${usageLine(usage)}. ` +
+        'El razonamiento del modelo consumió el presupuesto; sube el límite por variable de entorno.',
+    );
+  }
+  const m = text.match(new RegExp(`\\${open}[\\s\\S]*\\${close}`));
+  if (!m) throw new Error(`LLM_BAD_JSON: ${label} no devolvió ningún bloque JSON${usageLine(usage)}`);
+  try {
+    return JSON.parse(m[0]);
+  } catch (e) {
+    throw new Error(`LLM_BAD_JSON: ${label} devolvió JSON no parseable (${e.message})${usageLine(usage)}`);
+  }
 }
 
