 });
 
+// --- admin: alta de instructores/alumnos y matrícula ---
+// El rol admin no se puede crear por API (solo seed / SQL). Matricular no
+// salta la cascada de prerrequisitos: el estudiante queda inscrito pero
+// bloqueado para avanzar hasta completar la asignatura anterior.
+route('GET', '/api/admin/users', async ({ res, user, query }) => {
+  if (!requireAdmin(res, user)) return;
+  const role = query.role && String(query.role).trim();
+  const q = query.q && String(query.q).trim();
+  const limit = Math.min(Math.max(Number(query.limit) || 100, 1), 200);
+  const params = [];
+  const where = [];
+  if (role) {
+    params.push(role);
+    where.push(`u.role = $${params.length}`);
+  }
+  if (q) {
+    params.push(`%${q}%`);
+    where.push(`(u.email ILIKE $${params.length} OR u.name ILIKE $${params.length})`);
+  }
+  params.push(limit);
+  const { rows } = await pool.query(
+    `SELECT u.id, u.email, u.name, u.role, u.created_at,
+            (SELECT count(*) FROM enrollments e WHERE e.user_id = u.id) AS enrollments
+       FROM users u
+      ${where.length ? `WHERE ${where.join(' AND ')}` : ''}
+      ORDER BY u.created_at DESC
+      LIMIT $${params.length}`,
+    params,
+  );
+  sendJSON(
+    res,
+    200,
+    rows.map((r) => ({
+      ...publicUser(r),
+      createdAt: r.created_at,
+      enrollments: Number(r.enrollments),
+    })),
+  );
+});
+
+route('POST', '/api/admin/users', async ({ res, user, body }) => {
+  if (!requireAdmin(res, user)) return;
+  const email = String(body.email || '').trim();
+  const name = String(body.name || '').trim().slice(0, 120);
+  const password = body.password;
+  const role = String(body.role || 'student').trim();
+  if (!isValidEmail(email) || !name || !isValidPassword(password)) {
+    return sendJSON(res, 400, { message: 'Datos inválidos (email, nombre y contraseña de 8+ caracteres)' });
+  }
+  if (!CREATABLE_ROLES.has(role)) {
+    return sendJSON(res, 400, { message: 'Rol no permitido. Usa student, instructor o director_tfm.' });
+  }
+  const exists = await pool.query('SELECT 1 FROM users WHERE email = $1', [email]);
+  if (exists.rowCount) return sendJSON(res, 409, { message: 'El email ya está registrado' });
+  const pw = newPasswordHash(password);
+  const { rows } = await pool.query(
+    `INSERT INTO users (email, name, password_hash, password_salt, password_algo, role)
+     VALUES ($1, $2, $3, $4, $5, $6)
+     RETURNING id, email, name, role, created_at`,
+    [email, name, pw.hash, pw.salt, pw.algo, role],
+  );
+  sendJSON(res, 201, { ...publicUser(rows[0]), createdAt: rows[0].created_at, enrollments: 0 });
+});
+
+route('GET', '/api/admin/users/:id', async ({ res, user, params }) => {
+  if (!requireAdmin(res, user)) return;
+  if (!isUuid(params.id)) return sendJSON(res, 400, { message: 'id inválido' });
+  const u = (await pool.query('SELECT id, email, name, role, created_at FROM users WHERE id = $1', [params.id])).rows[0];
+  if (!u) return sendJSON(res, 404, { message: 'Usuario no encontrado' });
+  const { rows } = await pool.query(
+    `SELECT e.course_id, e.role, e.enrolled_at, c.slug, c.title, c.kind
+       FROM enrollments e JOIN courses c ON c.id = e.course_id
+      WHERE e.user_id = $1
+      ORDER BY c.order_index, c.title`,
+    [u.id],
+  );
+  sendJSON(res, 200, {
+    ...publicUser(u),
+    createdAt: u.created_at,
+    enrollments: rows.map((r) => ({
+      courseId: r.course_id,
+      slug: r.slug,
+      title: r.title,
+      kind: r.kind,
+      role: r.role,
+      enrolledAt: r.enrolled_at,
+    })),
+  });
+});
+
+route('POST', '/api/admin/enrollments', async ({ res, user, body }) => {
+  if (!requireAdmin(res, user)) return;
+  if (!isUuid(body.userId)) return sendJSON(res, 400, { message: 'userId inválido' });
+  const target = (await pool.query('SELECT id, role FROM users WHERE id = $1', [body.userId])).rows[0];
+  if (!target) return sendJSON(res, 404, { message: 'Usuario no encontrado' });
+  if (target.role === 'admin') {
+    return sendJSON(res, 400, { message: 'No se matricula a un administrador en cursos.' });
+  }
+  const enrollmentRole = body.role
+    ? String(body.role).trim()
+    : defaultEnrollmentRole(target.role);
+  if (!ENROLLMENT_ROLES.has(enrollmentRole)) {
+    return sendJSON(res, 400, { message: 'El rol de matrícula debe ser student o instructor.' });
+  }
+  const courses = await resolveCoursesForEnroll(body);
+  if (!courses.length) {
+    return sendJSON(res, 400, { message: 'Indica courseId, courseIds o programSlug.' });
+  }
+  const enrolled = [];
+  for (const course of courses) {
+    enrolled.push(await enrollUserInCourse(target.id, course, enrollmentRole));
+  }
+  sendJSON(res, 201, { ok: true, userId: target.id, enrolled });
+});
+
+route('DELETE', '/api/admin/users/:userId/enrollments/:courseId', async ({ res, user, params }) => {
+  if (!requireAdmin(res, user)) return;
+  if (!isUuid(params.userId) || !isUuid(params.courseId)) {
+    return sendJSON(res, 400, { message: 'id inválido' });
+  }
+  const del = await pool.query('DELETE FROM enrollments WHERE user_id = $1 AND course_id = $2 RETURNING id', [
+    params.userId,
+    params.courseId,
+  ]);
+  if (!del.rowCount) return sendJSON(res, 404, { message: 'Matrícula no encontrada' });
+  sendJSON(res, 200, { ok: true });
+});
+
