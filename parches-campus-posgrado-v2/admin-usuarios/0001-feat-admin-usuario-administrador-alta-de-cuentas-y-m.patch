diff --git a/backend/simple-server.js b/backend/simple-server.js
index f248d5e..b9b1310 100644
--- a/backend/simple-server.js
+++ b/backend/simple-server.js
@@ -111,6 +111,83 @@ async function getAuthUser(req) {
 // ---------- serializadores ----------
 const publicUser = (u) => ({ id: u.id, email: u.email, name: u.name, role: u.role });
 
+const CREATABLE_ROLES = new Set(['student', 'instructor', 'director_tfm']);
+const ENROLLMENT_ROLES = new Set(['student', 'instructor']);
+
+function requireAdmin(res, user) {
+  if (!user) {
+    sendJSON(res, 401, { message: 'Unauthorized' });
+    return false;
+  }
+  if (user.role !== 'admin') {
+    sendJSON(res, 403, { message: 'Forbidden' });
+    return false;
+  }
+  return true;
+}
+
+function defaultEnrollmentRole(userRole) {
+  return userRole === 'instructor' || userRole === 'director_tfm' ? 'instructor' : 'student';
+}
+
+async function resolveCoursesForEnroll(body) {
+  const found = [];
+  const seen = new Set();
+  const add = (row) => {
+    if (row && !seen.has(row.id)) {
+      seen.add(row.id);
+      found.push(row);
+    }
+  };
+  const programSlug = body.programSlug && String(body.programSlug).trim();
+  if (programSlug) {
+    const { rows } = await pool.query(
+      `SELECT * FROM courses WHERE published AND meta->>'programSlug' = $1 ORDER BY order_index, title`,
+      [programSlug],
+    );
+    rows.forEach(add);
+  }
+  const ids = [];
+  if (body.courseId) ids.push(body.courseId);
+  if (Array.isArray(body.courseIds)) ids.push(...body.courseIds);
+  for (const id of ids) {
+    add(await findCourseRow(String(id || '')));
+  }
+  return found;
+}
+
+async function enrollUserInCourse(userId, course, enrollmentRole) {
+  const ins = await pool.query(
+    `INSERT INTO enrollments (user_id, course_id, role) VALUES ($1, $2, $3)
+     ON CONFLICT (user_id, course_id) DO UPDATE SET role = EXCLUDED.role
+     RETURNING id`,
+    [userId, course.id, enrollmentRole],
+  );
+  if (enrollmentRole === 'instructor') {
+    await pool.query(`UPDATE courses SET instructor_id = $1, updated_at = now() WHERE id = $2`, [
+      userId,
+      course.id,
+    ]);
+  }
+  let tfm = false;
+  if (course.slug === 'master-tfm' && enrollmentRole === 'student') {
+    const t = await pool.query(
+      `INSERT INTO tfm_enrollments (user_id, status) VALUES ($1, 'in_progress')
+       ON CONFLICT (user_id) DO NOTHING RETURNING id`,
+      [userId],
+    );
+    tfm = t.rowCount > 0;
+  }
+  return {
+    courseId: course.id,
+    slug: course.slug,
+    title: course.title,
+    role: enrollmentRole,
+    created: ins.rowCount > 0,
+    tfm,
+  };
+}
+
 function courseSummary(row) {
   const total = Number(row.total || 0);
   const completed = Number(row.completed || 0);
@@ -2291,11 +2368,139 @@ route('PUT', '/api/notifications/:id/read', async ({ res, user, params }) => {
