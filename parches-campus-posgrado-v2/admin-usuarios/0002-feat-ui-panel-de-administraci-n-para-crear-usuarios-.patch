+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { api } from '../services/api'
+
+export type AdminRole = 'student' | 'instructor' | 'director_tfm' | 'admin'
+export type EnrollmentRole = 'student' | 'instructor'
+
+export interface AdminUser {
+  id: string
+  email: string
+  name: string
+  role: AdminRole
+  createdAt?: string
+  enrollments: number
+}
+
+export interface AdminEnrollment {
+  courseId: string
+  slug: string
+  title: string
+  kind: string
+  role: EnrollmentRole
+  enrolledAt: string
+}
+
+export interface AdminUserDetail extends Omit<AdminUser, 'enrollments'> {
+  enrollments: AdminEnrollment[]
+}
+
+export function useAdminUsers(filters: { role?: string; q?: string }) {
+  return useQuery<AdminUser[]>({
+    queryKey: ['admin-users', filters],
+    queryFn: async () => {
+      const response = await api.get<AdminUser[]>('/admin/users', {
+        params: {
+          role: filters.role || undefined,
+          q: filters.q || undefined,
+        },
+      })
+      return response.data
+    },
+  })
+}
+
+export function useAdminUser(userId: string | null) {
+  return useQuery<AdminUserDetail>({
+    queryKey: ['admin-user', userId],
+    queryFn: async () => {
+      const response = await api.get<AdminUserDetail>(`/admin/users/${userId}`)
+      return response.data
+    },
+    enabled: !!userId,
+  })
+}
+
+export function useCreateAdminUser() {
+  const qc = useQueryClient()
+  return useMutation({
+    mutationFn: async (body: { email: string; name: string; password: string; role: Exclude<AdminRole, 'admin'> }) => {
+      const response = await api.post<AdminUser>('/admin/users', body)
+      return response.data
+    },
+    onSuccess: () => {
+      qc.invalidateQueries({ queryKey: ['admin-users'] })
+    },
+  })
+}
+
+export function useAdminEnroll() {
+  const qc = useQueryClient()
+  return useMutation({
+    mutationFn: async (body: {
+      userId: string
+      courseId?: string
+      courseIds?: string[]
+      programSlug?: string
+      role?: EnrollmentRole
+    }) => {
+      const response = await api.post<{
+        ok: boolean
+        userId: string
+        enrolled: { courseId: string; slug: string; title: string; role: string; created: boolean }[]
+      }>('/admin/enrollments', body)
+      return response.data
+    },
+    onSuccess: (_data, vars) => {
+      qc.invalidateQueries({ queryKey: ['admin-users'] })
+      qc.invalidateQueries({ queryKey: ['admin-user', vars.userId] })
+      qc.invalidateQueries({ queryKey: ['courses'] })
+    },
+  })
+}
+
+export function useAdminUnenroll() {
+  const qc = useQueryClient()
+  return useMutation({
+    mutationFn: async (vars: { userId: string; courseId: string }) => {
+      await api.delete(`/admin/users/${vars.userId}/enrollments/${vars.courseId}`)
+    },
+    onSuccess: (_data, vars) => {
+      qc.invalidateQueries({ queryKey: ['admin-users'] })
+      qc.invalidateQueries({ queryKey: ['admin-user', vars.userId] })
+    },
+  })
+}
