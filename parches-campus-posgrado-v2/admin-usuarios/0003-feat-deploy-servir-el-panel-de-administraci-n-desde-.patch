--- a/.dockerignore
+++ b/.dockerignore
@@ -1,6 +1,5 @@
-# Contexto de build mínimo (la imagen solo necesita backend/{simple-server.js,lib,db,scripts})
+# Contexto de build: backend + frontend (el Dockerfile construye el SPA).
 **/node_modules
-frontend
 mobile
