 const TFM_SPEC = tryRequire('tfm.js');
 
+// Plantillas versionadas en el repositorio (notebooks hands-on y memoria del TFM).
+// Los `.ipynb` viven en `plantillas/` y se enlazan desde la entrega; GitHub los
+// renderiza sin que el estudiante tenga que clonar nada. La base es configurable
+// para reapuntar a un fork, a otra rama o a un CDN.
+const PLANTILLAS_BASE_URL = (
+  process.env.PLANTILLAS_BASE_URL ||
+  'https://github.com/edilsonalvarez-create/campus-posgrado-v2/blob/main'
+).replace(/\/+$/, '');
+const plantillaUrl = (rel) => (rel ? `${PLANTILLAS_BASE_URL}/${String(rel).replace(/^\/+/, '')}` : null);
+
+// La memoria del TFM se sirve DENTRO de la plataforma como recurso markdown, así
+// que su fuente vive junto al resto del seed: el Dockerfile de producción solo
+// copia `backend/db`, y un enlace externo dejaría al estudiante sin la plantilla
+// si el repositorio cambia de sitio.
+const TFM_MEMORIA = (() => {
+  try {
+    return fs.readFileSync(path.join(DATA, 'tfm-memoria.md'), 'utf8');
+  } catch (err) {
+    console.warn('[seed] tfm-memoria.md:', err.message);
+    return null;
+  }
+})();
