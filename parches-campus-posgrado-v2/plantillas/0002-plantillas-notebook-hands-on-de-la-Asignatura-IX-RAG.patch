+    "def normalizar_texto(texto):\n",
+    "    texto = texto.lower()\n",
+    "    for original, reemplazo in ((\"á\", \"a\"), (\"é\", \"e\"), (\"í\", \"i\"), (\"ó\", \"o\"), (\"ú\", \"u\")):\n",
+    "        texto = texto.replace(original, reemplazo)\n",
+    "    return re.sub(r\"\\s+\", \" \", texto)\n",
+    "\n",
+    "\n",
+    "def es_abstencion(texto):\n",
+    "    return \"no consta\" in normalizar_texto(texto)\n",
+    "\n",
+    "\n",
+    "def contiene_hechos(respuesta, hechos):\n",
+    "    if not hechos:\n",
+    "        return np.nan\n",
+    "    normalizada = normalizar_texto(respuesta)\n",
+    "    return float(all(normalizar_texto(h) in normalizada for h in hechos))\n",
+    "\n",
+    "\n",
+    "def fundamentacion(respuesta, trozos):\n",
+    "    \"\"\"Proporción de n-gramas de la respuesta que aparecen literalmente en el contexto.\"\"\"\n",
+    "    if es_abstencion(respuesta):\n",
+    "        return np.nan\n",
+    "    contexto = normalizar_texto(\" \".join(t[\"texto\"] for t in trozos))\n",
+    "    palabras = normalizar_texto(respuesta).split()\n",
+    "    if len(palabras) < 5:\n",
+    "        return np.nan\n",
+    "    quintetos = [\" \".join(palabras[i:i + 5]) for i in range(len(palabras) - 4)]\n",
+    "    return float(np.mean([q in contexto for q in quintetos]))\n",
+    "\n",
+    "\n",
+    "def evaluar(recuperador, generador, preguntas, k=K_PRODUCCION):\n",
+    "    filas = []\n",
+    "    for caso in preguntas:\n",
+    "        recuperados = recuperador.recuperar(caso[\"pregunta\"], k=k)\n",
+    "        salida = generador.responder(caso[\"pregunta\"], recuperados)\n",
+    "        docs = [t[\"doc_id\"] for t in recuperados]\n",
+    "        abstuvo = es_abstencion(salida[\"texto\"])\n",
