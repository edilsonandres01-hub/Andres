+    "def metricas_recuperacion(recuperador, preguntas, k=4):\n",
+    "    \"\"\"Métricas de recuperación sobre las preguntas respondibles (las que tienen oro).\"\"\"\n",
+    "    filas = []\n",
+    "    for caso in preguntas:\n",
+    "        if not caso[\"respondible\"]:\n",
+    "            continue\n",
+    "        recuperados = recuperador.recuperar(caso[\"pregunta\"], k=k)\n",
+    "        docs = [t[\"doc_id\"] for t in recuperados]\n",
+    "        oro = set(caso[\"doc_oro\"])\n",
+    "\n",
+    "        acierto = int(bool(oro & set(docs)))\n",
+    "        exhaustividad = len(oro & set(docs)) / len(oro) if oro else np.nan\n",
+    "        rango_reciproco = 0.0\n",
+    "        for posicion, doc in enumerate(docs, 1):\n",
+    "            if doc in oro:\n",
+    "                rango_reciproco = 1.0 / posicion\n",
+    "                break\n",
+    "        # Cada documento de oro cuenta una sola vez, aunque se recuperen varios trozos suyos:\n",
+    "        # sin esta deduplicación el nDCG puede superar 1 y deja de ser interpretable.\n",
+    "        acreditados, ganancias = set(), []\n",
+    "        for doc in docs:\n",
+    "            if doc in oro and doc not in acreditados:\n",
+    "                acreditados.add(doc)\n",
+    "                ganancias.append(1.0)\n",
+    "            else:\n",
+    "                ganancias.append(0.0)\n",
+    "        dcg = sum(g / np.log2(i + 2) for i, g in enumerate(ganancias))\n",
+    "        ideal = sum(1.0 / np.log2(i + 2) for i in range(min(len(oro), k)))\n",
+    "        filas.append(\n",
+    "            {\n",
+    "                \"id\": caso[\"id\"], \"k\": k, \"acierto\": acierto, \"exhaustividad\": exhaustividad,\n",
+    "                \"rango_reciproco\": rango_reciproco, \"ndcg\": dcg / ideal if ideal else np.nan,\n",
+    "                \"primer_doc\": docs[0] if docs else None,\n",
+    "            }\n",
+    "        )\n",
+    "    return pd.DataFrame(filas)\n",
+    "\n",
+    "\n",
+    "barrido = []\n",
+    "for k in (1, 2, 3, 4, 6, 8):\n",
