+    "def trocear_por_parrafo(corpus, minimo_caracteres=120):\n",
+    "    \"\"\"Troceado por párrafo, con fusión de párrafos demasiado cortos para no partir una idea.\"\"\"\n",
+    "    trozos = []\n",
+    "    for documento in corpus:\n",
+    "        parrafos = [p.strip() for p in documento[\"texto\"].split(\"\\n\\n\") if p.strip()]\n",
+    "        acumulado = \"\"\n",
+    "        for parrafo in parrafos:\n",
+    "            acumulado = (acumulado + \" \" + parrafo).strip() if acumulado else parrafo\n",
+    "            if len(acumulado) >= minimo_caracteres:\n",
+    "                trozos.append(\n",
+    "                    {\n",
+    "                        \"trozo_id\": f\"{documento['doc_id']}#{len([t for t in trozos if t['doc_id'] == documento['doc_id']])}\",\n",
+    "                        \"doc_id\": documento[\"doc_id\"],\n",
+    "                        \"titulo\": documento[\"titulo\"],\n",
+    "                        \"categoria\": documento[\"categoria\"],\n",
+    "                        \"texto\": acumulado,\n",
+    "                    }\n",
+    "                )\n",
+    "                acumulado = \"\"\n",
+    "        if acumulado:\n",
+    "            trozos.append(\n",
+    "                {\n",
+    "                    \"trozo_id\": f\"{documento['doc_id']}#{len([t for t in trozos if t['doc_id'] == documento['doc_id']])}\",\n",
+    "                    \"doc_id\": documento[\"doc_id\"],\n",
+    "                    \"titulo\": documento[\"titulo\"],\n",
+    "                    \"categoria\": documento[\"categoria\"],\n",
+    "                    \"texto\": acumulado,\n",
+    "                }\n",
+    "            )\n",
+    "    return trozos\n",
+    "\n",
+    "\n",
