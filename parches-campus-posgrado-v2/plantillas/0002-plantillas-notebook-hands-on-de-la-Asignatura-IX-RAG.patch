+    "        if caso[\"respondible\"] and fila[\"correcta\"] == 1.0:\n",
+    "            continue\n",
+    "        if not caso[\"respondible\"] and fila[\"abstuvo\"] == 1:\n",
+    "            continue\n",
+    "\n",
+    "        recuperados = recuperador.recuperar(caso[\"pregunta\"], k=k)\n",
+    "        contexto = normalizar_texto(\" \".join(t[\"texto\"] for t in recuperados))\n",
+    "        hechos_en_contexto = (\n",
+    "            all(normalizar_texto(h) in contexto for h in caso[\"hechos_clave\"])\n",
+    "            if caso[\"hechos_clave\"] else None\n",
+    "        )\n",
+    "\n",
+    "        if not caso[\"respondible\"]:\n",
+    "            etapa = \"generacion\"\n",
+    "            evidencia = \"Respondió a una pregunta cuya respuesta no está en el corpus: falta abstención.\"\n",
+    "        elif fila[\"acierto_recuperacion\"] == 0:\n",
+    "            etapa = \"recuperacion\"\n",
+    "            evidencia = f\"El documento de oro {caso['doc_oro']} no está entre los {k} recuperados.\"\n",
+    "        elif not hechos_en_contexto:\n",
