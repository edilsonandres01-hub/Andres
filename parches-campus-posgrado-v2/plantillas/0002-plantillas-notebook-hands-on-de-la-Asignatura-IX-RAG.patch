+    "            {\n",
+    "                \"id\": caso[\"id\"],\n",
+    "                \"respondible\": caso[\"respondible\"],\n",
+    "                \"pregunta\": caso[\"pregunta\"],\n",
+    "                \"respuesta\": salida[\"texto\"],\n",
