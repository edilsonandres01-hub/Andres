+    "\n",
+    "\n",
+    "class GeneradorExtractivo:\n",
+    "    \"\"\"Generador local, determinista y sin dependencias externas.\n",
+    "\n",
+    "    Selecciona del contexto la frase más similar a la pregunta y se abstiene si ninguna\n",
+    "    supera el umbral. Es la línea base contra la que comparar tu LLM.\n",
+    "    \"\"\"\n",
+    "\n",
+    "    nombre = \"extractivo_local\"\n",
+    "    coste_por_1k_entrada = 0.0\n",
+    "    coste_por_1k_salida = 0.0\n",
+    "\n",
+    "    def __init__(self, umbral=UMBRAL_ABSTENCION):\n",
+    "        self.umbral = umbral\n",
+    "\n",
+    "    def responder(self, pregunta, trozos):\n",
+    "        frases = [(frase, trozo) for trozo in trozos for frase in dividir_en_frases(trozo[\"texto\"])]\n",
+    "        tokens_entrada = estimar_tokens(pregunta) + sum(estimar_tokens(t[\"texto\"]) for t in trozos)\n",
+    "        if not frases:\n",
+    "            return {\"texto\": FRASE_ABSTENCION, \"citas\": [], \"tokens_entrada\": tokens_entrada,\n",
+    "                    \"tokens_salida\": estimar_tokens(FRASE_ABSTENCION), \"confianza\": 0.0}\n",
+    "\n",
+    "        vectorizador = TfidfVectorizer(strip_accents=\"unicode\", sublinear_tf=True)\n",
+    "        matriz = vectorizador.fit_transform([f for f, _ in frases] + [pregunta])\n",
+    "        similitudes = cosine_similarity(matriz[-1], matriz[:-1]).ravel()\n",
+    "        mejor = int(np.argmax(similitudes))\n",
+    "        confianza = float(similitudes[mejor])\n",
+    "\n",
+    "        if confianza < self.umbral:\n",
+    "            texto, citas = FRASE_ABSTENCION, []\n",
+    "        else:\n",
+    "            frase, trozo = frases[mejor]\n",
+    "            texto, citas = frase, [trozo[\"doc_id\"]]\n",
+    "        return {\"texto\": texto, \"citas\": citas, \"tokens_entrada\": tokens_entrada,\n",
