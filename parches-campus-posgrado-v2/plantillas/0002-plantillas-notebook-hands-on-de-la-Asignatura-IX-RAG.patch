+    "            \"acierto@k\": detalle[\"acierto\"].mean(),\n",
+    "            \"exhaustividad@k\": detalle[\"exhaustividad\"].mean(),\n",
+    "            \"MRR\": detalle[\"rango_reciproco\"].mean(),\n",
