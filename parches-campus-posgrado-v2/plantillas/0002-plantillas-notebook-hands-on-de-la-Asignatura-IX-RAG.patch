+    "                \"correcta\": contiene_hechos(salida[\"texto\"], caso[\"hechos_clave\"]) if caso[\"respondible\"] else np.nan,\n",
+    "                \"fundamentacion\": fundamentacion(salida[\"texto\"], recuperados),\n",
+    "                \"abstuvo\": int(abstuvo),\n",
+    "                \"cita_correcta\": (\n",
+    "                    int(bool(set(salida[\"citas\"]) & set(caso[\"doc_oro\"]))) if caso[\"respondible\"] and salida[\"citas\"] else 0\n",
+    "                ),\n",
+    "                \"confianza\": salida.get(\"confianza\", np.nan),\n",
+    "                \"tokens_entrada\": salida[\"tokens_entrada\"],\n",
+    "                \"tokens_salida\": salida[\"tokens_salida\"],\n",
+    "            }\n",
+    "        )\n",
+    "    return pd.DataFrame(filas)\n",
+    "\n",
+    "\n",
+    "def resumir(detalle, generador, k=K_PRODUCCION, umbral=None):\n",
+    "    respondibles = detalle[detalle[\"respondible\"]]\n",
+    "    sin_respuesta = detalle[~detalle[\"respondible\"]]\n",
+    "    return {\n",
+    "        \"generador\": generador.nombre,\n",
+    "        \"k\": k,\n",
+    "        \"umbral_abstencion\": umbral if umbral is not None else getattr(generador, \"umbral\", np.nan),\n",
+    "        # recuperación\n",
+    "        \"acierto_recuperacion\": respondibles[\"acierto_recuperacion\"].mean(),\n",
