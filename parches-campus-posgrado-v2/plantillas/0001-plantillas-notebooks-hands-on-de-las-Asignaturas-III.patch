+    "        lineas += [f\"## {titulo}\", \"\", str(cuerpo), \"\"]\n",
+    "    lineas += [\"## Variables más influyentes\", \"\", f\"Método: {tarjeta['metodo_explicacion']}\", \"\"]\n",
+    "    lineas += [f\"{i}. `{v}`\" for i, v in enumerate(tarjeta[\"top5_variables\"], 1)] + [\"\"]\n",
