+    "    )\n",
+    "\n",
+    "\n",
+    "K_PRESUPUESTO = 50\n",
+    "\n",
+    "\n",
+    "def precision_en_presupuesto(y_real, puntuaciones, k=K_PRESUPUESTO):\n",
+    "    \"\"\"De las k filas peor puntuadas, ¿qué fracción corresponde a un fallo real?\n",
+    "\n",
+    "    Es la métrica que entiende el jefe de mantenimiento: si esta semana solo puedo mandar\n",
+    "    cuadrilla a k equipos, ¿cuántas de esas visitas van a servir para algo?\n",
+    "    \"\"\"\n",
+    "    orden = np.argsort(puntuaciones)[::-1][:k]\n",
+    "    return float(np.mean(np.asarray(y_real)[orden]))\n",
+    "\n",
+    "\n",
+    "def intervalo_bootstrap(y_real, puntuaciones, funcion, repeticiones=200, semilla=SEMILLA):\n",
+    "    rng = np.random.default_rng(semilla)\n",
+    "    y_real = np.asarray(y_real)\n",
