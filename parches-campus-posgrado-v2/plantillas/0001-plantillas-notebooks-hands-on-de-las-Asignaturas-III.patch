+    "MODEL_CARD = {\n",
+    "    \"nombre\": \"TODO: nombre y versión del modelo (p. ej. compresor-fallo14d v1.0)\",\n",
+    "    \"fecha\": pd.Timestamp.today().date().isoformat(),\n",
+    "    \"autor\": \"TODO: tu nombre\",\n",
