+    "    \"linea_base\": \"TODO: valor de la línea base y diferencia frente al modelo\",\n",
+    "    \"top5_variables\": TOP5_PERMUTACION,\n",
+    "    \"metodo_explicacion\": \"Importancia por permutación\" + (\" + valores SHAP\" if SHAP_DISPONIBLE else \"\"),\n",
+    "    \"variables_excluidas_por_fuga\": VARIABLES_CONTAMINADAS,\n",
+    "    \"limitaciones\": [\n",
+    "        \"TODO: dónde falla el modelo (¿tramos de RUL? ¿modelos de equipo poco representados?)\",\n",
