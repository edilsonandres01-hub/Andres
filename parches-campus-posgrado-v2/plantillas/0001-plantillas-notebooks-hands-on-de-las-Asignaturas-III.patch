+    "@dataclass\n",
+    "class FichaProblema:\n",
+    "    \"\"\"Contrato que hay que firmar ANTES de entrenar.\"\"\"\n",
+    "\n",
+    "    nombre: str\n",
+    "    paradigma: str                 # 'clasificacion' | 'regresion' | 'no_supervisado'\n",
+    "    pregunta_negocio: str\n",
+    "    metrica_principal: str\n",
+    "    justificacion_metrica: str     # en términos del coste de cada tipo de error\n",
+    "    linea_base: str                # la regla operativa vigente, no \"el azar\"\n",
+    "    coste_falso_positivo: str = \"\"\n",
+    "    coste_falso_negativo: str = \"\"\n",
+    "\n",
+    "    def completa(self):\n",
+    "        obligatorios = [\n",
+    "            self.pregunta_negocio, self.metrica_principal,\n",
+    "            self.justificacion_metrica, self.linea_base,\n",
+    "        ]\n",
+    "        return all(bool(str(campo).strip()) and \"TODO\" not in str(campo) for campo in obligatorios)\n",
+    "\n",
+    "\n",
+    "FICHAS = {}\n",
+    "RESULTADOS = []\n",
+    "PENDIENTES = {}\n",
+    "\n",
+    "\n",
+    "def registrar_ficha(ficha):\n",
+    "    FICHAS[ficha.nombre] = ficha\n",
+    "    estado = \"completa\" if ficha.completa() else \"INCOMPLETA — rellénala antes de entrenar\"\n",
+    "    print(f\"ficha '{ficha.nombre}': {estado}\")\n",
+    "    return ficha\n",
+    "\n",
+    "\n",
+    "def registrar_resultado(nombre_problema, modelo, metricas, notas=\"\"):\n",
