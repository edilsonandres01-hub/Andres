+    "        pregunta_negocio=\"¿Qué compresores fallarán en los próximos 14 días?\",\n",
+    "        metrica_principal=\"average_precision (AUC-PR)\",\n",
+    "        justificacion_metrica=(\n",
+    "            \"La prevalencia ronda el 5 %: la exactitud premia al modelo que nunca predice fallo y el \"\n",
