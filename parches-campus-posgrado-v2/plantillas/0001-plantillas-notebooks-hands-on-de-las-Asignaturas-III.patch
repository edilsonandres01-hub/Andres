+    "\n",
+    "\n",
+    "def _bloque(n, rng, offset_segundos):\n",
+    "    \"\"\"Un bloque de lecturas con estacionalidad por turno y desviación por línea.\"\"\"\n",
+    "    segundos = offset_segundos + np.arange(n, dtype=np.int64)\n",
