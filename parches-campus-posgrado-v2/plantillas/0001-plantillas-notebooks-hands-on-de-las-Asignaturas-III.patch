+    "}\n",
+    "\n",
+    "\n",
+    "def render_model_card(tarjeta):\n",
+    "    lineas = [f\"# Model card — {tarjeta['nombre']}\", \"\"]\n",
+    "    lineas += [f\"**Autor:** {tarjeta['autor']} · **Fecha:** {tarjeta['fecha']}\", \"\"]\n",
