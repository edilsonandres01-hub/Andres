+    "MODELO_CARGADO = joblib.load(RUTA_MODELO)\n",
+    "UMBRAL_DECISION = 0.5\n",
+    "CONTADORES = {\"peticiones\": 0, \"errores_validacion\": 0, \"fuera_de_rango\": 0}\n",
+    "REGISTRO_PETICIONES = []\n",
+    "\n",
+    "\n",
+    "def validar(peticion, firma):\n",
+    "    faltan = [campo for campo in firma[\"campos\"] if campo not in peticion]\n",
+    "    if faltan:\n",
