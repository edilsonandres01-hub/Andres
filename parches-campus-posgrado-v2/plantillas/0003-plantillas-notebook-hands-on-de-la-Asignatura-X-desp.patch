+    "        estadistico, valor_p = stats.ks_2samp(referencia[campo], produccion[campo])\n",
+    "        filas.append(\n",
+    "            {\n",
+    "                \"variable\": campo,\n",
+    "                \"psi\": indice,\n",
+    "                \"estado\": semaforo(indice),\n",
+    "                \"ks_estadistico\": float(estadistico),\n",
+    "                \"ks_valor_p\": float(valor_p),\n",
+    "                \"media_referencia\": float(referencia[campo].mean()),\n",
+    "                \"media_produccion\": float(produccion[campo].mean()),\n",
+    "            }\n",
+    "        )\n",
+    "    return pd.DataFrame(filas)\n",
