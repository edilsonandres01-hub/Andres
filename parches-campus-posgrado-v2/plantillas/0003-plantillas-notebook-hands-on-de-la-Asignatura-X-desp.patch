+    "from scipy import stats\n",
+    "\n",
+    "\n",
+    "def psi(referencia, produccion, n_cortes=10):\n",
+    "    \"\"\"Índice de estabilidad de la población. Cortes fijados en la referencia, nunca en producción.\"\"\"\n",
+    "    cortes = np.quantile(referencia, np.linspace(0, 1, n_cortes + 1))\n",
+    "    cortes[0], cortes[-1] = -np.inf, np.inf\n",
+    "    cortes = np.unique(cortes)\n",
+    "    p_ref, _ = np.histogram(referencia, bins=cortes)\n",
+    "    p_pro, _ = np.histogram(produccion, bins=cortes)\n",
+    "    p_ref = np.clip(p_ref / max(p_ref.sum(), 1), 1e-6, None)\n",
+    "    p_pro = np.clip(p_pro / max(p_pro.sum(), 1), 1e-6, None)\n",
+    "    return float(np.sum((p_pro - p_ref) * np.log(p_pro / p_ref)))\n",
+    "\n",
+    "\n",
+    "def semaforo(valor):\n",
+    "    return \"estable\" if valor < 0.10 else (\"vigilar\" if valor < 0.25 else \"INVESTIGAR\")\n",
+    "\n",
+    "\n",
+    "def informe_deriva(referencia, produccion, campos=CAMPOS):\n",
