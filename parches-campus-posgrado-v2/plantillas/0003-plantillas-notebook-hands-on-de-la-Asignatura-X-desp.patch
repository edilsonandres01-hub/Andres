+    "\n",
+    "def generar_telemetria(n=9000, semilla=SEMILLA, desplazamiento=None):\n",
+    "    \"\"\"Telemetría de compresores. `desplazamiento` permite simular deriva más adelante.\"\"\"\n",
+    "    rng = np.random.default_rng(semilla)\n",
+    "    degradacion = rng.beta(2.0, 5.0, n)\n",
+    "    datos = pd.DataFrame(\n",
+    "        {\n",
+    "            \"vibracion_mm_s\": 2.0 + 6.5 * degradacion**2 + rng.normal(0, 0.5, n),\n",
