+    "def sha_de(objeto):\n",
+    "    return hashlib.sha256(repr(objeto).encode(\"utf-8\")).hexdigest()[:16]\n",
+    "\n",
+    "\n",
+    "class RegistroModelos:\n",
+    "    \"\"\"Registro mínimo de versiones. Sustituible por MLflow sin cambiar el resto del notebook.\"\"\"\n",
+    "\n",
+    "    def __init__(self, ruta=DIR_MODELOS / \"registro.json\"):\n",
+    "        self.ruta = Path(ruta)\n",
+    "        self.entradas = json.loads(self.ruta.read_text(encoding=\"utf-8\")) if self.ruta.exists() else []\n",
+    "\n",
+    "    def registrar(self, nombre, ruta_artefacto, metricas, firma, sha_datos, sha_codigo, etapa=\"pruebas\"):\n",
+    "        version = 1 + max([e[\"version\"] for e in self.entradas if e[\"nombre\"] == nombre], default=0)\n",
+    "        entrada = {\n",
+    "            \"nombre\": nombre,\n",
+    "            \"version\": version,\n",
+    "            \"creado_en\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\"),\n",
+    "            \"artefacto\": str(ruta_artefacto),\n",
+    "            \"sha_artefacto\": hashlib.sha256(Path(ruta_artefacto).read_bytes()).hexdigest()[:16],\n",
+    "            \"sha_datos\": sha_datos,\n",
+    "            \"sha_codigo\": sha_codigo,\n",
+    "            \"metricas\": metricas,\n",
+    "            \"firma\": firma,\n",
+    "            \"entorno\": {\n",
+    "                \"python\": sys.version.split()[0],\n",
+    "                \"plataforma\": platform.system(),\n",
+    "                \"numpy\": np.__version__,\n",
+    "                \"pandas\": pd.__version__,\n",
+    "            },\n",
+    "            \"etapa\": etapa,\n",
+    "        }\n",
+    "        self.entradas.append(entrada)\n",
+    "        self._guardar()\n",
+    "        return entrada\n",
+    "\n",
+    "    def promover(self, nombre, version, etapa=\"produccion\"):\n",
+    "        for entrada in self.entradas:\n",
+    "            if entrada[\"nombre\"] == nombre and entrada[\"etapa\"] == etapa:\n",
+    "                entrada[\"etapa\"] = \"retirado\"       # solo una versión por etapa\n",
+    "            if entrada[\"nombre\"] == nombre and entrada[\"version\"] == version:\n",
+    "                entrada[\"etapa\"] = etapa\n",
+    "        self._guardar()\n",
+    "\n",
+    "    def en_produccion(self, nombre):\n",
+    "        candidatos = [e for e in self.entradas if e[\"nombre\"] == nombre and e[\"etapa\"] == \"produccion\"]\n",
+    "        return candidatos[-1] if candidatos else None\n",
+    "\n",
+    "    def _guardar(self):\n",
+    "        self.ruta.write_text(json.dumps(self.entradas, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n",
+    "\n",
+    "\n",
+    "registro = RegistroModelos()\n",
+    "entrada = registro.registrar(\n",
+    "    nombre=\"compresor-fallo\",\n",
+    "    ruta_artefacto=RUTA_MODELO,\n",
+    "    metricas=METRICAS,\n",
+    "    firma=FIRMA,\n",
+    "    sha_datos=sha_de(pd.util.hash_pandas_object(X_ent).sum()),\n",
+    "    sha_codigo=\"TODO: sha del commit de tu repositorio (git rev-parse --short HEAD)\",\n",
+    ")\n",
+    "registro.promover(\"compresor-fallo\", entrada[\"version\"])\n",
+    "\n",
+    "produccion = registro.en_produccion(\"compresor-fallo\")\n",
+    "print(f\"en producción: {produccion['nombre']} v{produccion['version']} \"\n",
+    "      f\"(artefacto {produccion['sha_artefacto']}, datos {produccion['sha_datos']})\")\n",
+    "print(json.dumps(produccion, indent=2, ensure_ascii=False)[:900] + \"\\n…\")"
+   ],
