 // Cada término trae su definición textual con la fuente citada, la idea
@@ -19,7 +21,7 @@ type Termino = {
 
 type Paso = { titulo: string; texto: string }
 
-type PreguntaLG = { q: string; opts: string[]; a: number; why: string }
+type PreguntaLG = { q: string; opts: string[]; a: number; why: string | string[] }
 
 type Fuente = { titulo: string; url?: string | null }
 
@@ -34,6 +36,112 @@ export type LecturaGuiadaData = {
   fuentes: Fuente[]
 }
 
+function whyText(p: PreguntaLG, chosen: number | undefined): string {
+  const w = p.why
+  if (Array.isArray(w)) return String(w[chosen ?? p.a] ?? w[p.a] ?? '')
+  return String(w || '')
+}
+
+function PreguntasComprension({ preguntas }: { preguntas: PreguntaLG[] }) {
+  const [chosen, setChosen] = useState<Record<number, number>>({})
+  const [checked, setChecked] = useState<Record<number, boolean>>({})
+
+  return (
+    <div className="mt-6">
+      <p className="font-semibold text-gray-900 dark:text-white mb-2">Preguntas de comprensión</p>
+      <p className="text-xs text-gray-500 dark:text-gray-400 mb-3">
+        Elige una opción y pulsa Comprobar respuesta en cada pregunta.
+      </p>
+      <div className="space-y-4">
+        {preguntas.map((p, i) => {
+          const selected = chosen[i]
+          const isChecked = Boolean(checked[i])
+          const correct = isChecked && selected === p.a
+          return (
+            <div key={i} className="rounded border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-800 p-3">
+              <p className="text-gray-800 dark:text-gray-200 mb-3">
+                {i + 1}. {p.q}
+              </p>
+              <div className="space-y-2">
+                {p.opts.map((o, j) => {
+                  const isChosen = selected === j
+                  const isRight = isChecked && j === p.a
+                  const isWrongChoice = isChecked && isChosen && j !== p.a
+                  return (
+                    <button
+                      key={j}
+                      type="button"
+                      onClick={() => !isChecked && setChosen((c) => ({ ...c, [i]: j }))}
+                      disabled={isChecked}
+                      className={`w-full text-left px-3 py-2 rounded border text-sm flex items-start gap-2 ${
+                        isRight
+                          ? 'border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20'
+                          : isWrongChoice
+                            ? 'border-rose-500 bg-rose-50 dark:bg-rose-900/20'
+                            : isChosen
+                              ? 'border-primary-500 bg-primary-50 dark:bg-primary-900/20'
+                              : 'border-gray-300 dark:border-gray-600 hover:border-primary-300'
+                      } ${isChecked ? 'cursor-default' : 'cursor-pointer'}`}
+                    >
+                      <span
+                        className={`mt-0.5 h-4 w-4 shrink-0 rounded-full border ${
+                          isChosen ? 'border-primary-600 bg-primary-600' : 'border-gray-400 bg-white dark:bg-gray-800'
+                        }`}
+                        aria-hidden
+                      />
+                      <span>
+                        {String.fromCharCode(97 + j)}) {o}
+                      </span>
+                      {isChecked && (isRight ? <span className="ml-auto">✓</span> : isWrongChoice ? <span className="ml-auto">✗</span> : null)}
+                    </button>
+                  )
+                })}
+              </div>
+              {!isChecked ? (
+                <button
+                  type="button"
+                  onClick={() => setChecked((c) => ({ ...c, [i]: true }))}
+                  disabled={selected === undefined}
+                  className="mt-3 text-sm px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white disabled:bg-gray-400"
+                >
+                  Comprobar respuesta
+                </button>
+              ) : (
+                <div className="mt-3">
+                  <p className="text-sm text-gray-700 dark:text-gray-300">
+                    <span className={`font-semibold ${correct ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400'}`}>
+                      {correct ? 'Correcto. ' : 'Revisar. '}
+                    </span>
+                    {whyText(p, selected)}
+                  </p>
+                  <button
+                    type="button"
+                    onClick={() => {
+                      setChecked((c) => {
+                        const next = { ...c }
+                        delete next[i]
+                        return next
+                      })
+                      setChosen((c) => {
+                        const next = { ...c }
+                        delete next[i]
+                        return next
+                      })
+                    }}
+                    className="mt-2 text-sm text-primary-600 dark:text-primary-400 hover:underline"
+                  >
+                    Reintentar
+                  </button>
+                </div>
+              )}
+            </div>
+          )
+        })}
+      </div>
+    </div>
+  )
+}
